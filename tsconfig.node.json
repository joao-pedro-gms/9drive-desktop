{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2023"],
    "verbatimModuleSyntax": true,
    // Referenced by the root tsconfig, so it must be composite; emit only ever
    // lands in node_modules/.tmp.
    "composite": true,
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "svelte.config.js"]
}