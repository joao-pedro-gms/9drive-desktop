{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "9Drive",
  "version": "0.1.0",
  "identifier": "com.9drive.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "9Drive",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' 9drive: asset: http://asset.localhost data: blob:; media-src 'self' 9drive: blob:; frame-src 'self' 9drive: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}